# docker compose uchun sozlamalar. Nusxa oling:  cp .env.example .env
# Parollarda faqat harf/raqam/_ ishlating (DATABASE_URL ichiga tushadi).

MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=mahad_test_db
MYSQL_USER=mahad
MYSQL_PASSWORD=change_app_password

# Uzun tasodifiy qator:  openssl rand -hex 32
JWT_SECRET=change_me
# Token muddati. Mobil o'quvchilar har kuni qayta kirmasligi uchun 30d tavsiya etiladi.
JWT_EXPIRES=30d

# Mobil ilova uchun MINIMAL talab qilinadigan versiya (GET /api/v1/version).
# 1.4.0 qo'ysangiz — eski 1.3.x ilovalarga "Yangilang" ekrani chiqadi.
APP_VERSION=1.3.6

# Konteyner ishga tushganda prisma db push (xavfsiz rejimda)
DB_SYNC=true

# Tashqi portlar
HTTP_PORT=80
LEGACY_WEB_PORT=2222
LEGACY_API_PORT=3333
