model Student {
  id    Int     @default(autoincrement()) @id
  name  String?
  phone String  @unique
  password String
  group    Group?    @relation(fields: [group_id], references: [id])
  group_id  Int?

  results Result[]
  role Role @default(STUDENT)
  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}