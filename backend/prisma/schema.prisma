model Result {
  id    Int     @default(autoincrement()) @id
  solved  Int?
  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  startTime        DateTime?
  finishTime       DateTime?

  test  Test?    @relation(fields: [test_id], references: [id])
  test_id  Int?

  specialTest SpecialTest? @relation(fields: [special_test_id], references: [id])
  special_test_id Int?

  answers Json
  student  Student?    @relation(fields: [student_id], references: [id])
  student_id  Int?
  type String? @default("Book")
}

model Section {
  id    Int     @default(autoincrement()) @id
  name  String?
  image  String?
  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  book  Book?    @relation(fields: [book_id], references: [id])
  book_id  Int?
  
  test  Test?

  specialTestSections SpecialTestSection[]
}

model Student {
  id    Int     @default(autoincrement()) @id
  name  String?
  phone String  @unique
  password String
  group    Group?    @relation(fields: [group_id], references: [id])
  group_id  Int?

  results Result[]
  device  Device?
  role Role @default(STUDENT)
  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Subject {
  id    Int     @default(autoincrement()) @id
  name  String?
  image  String?
  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  books Book[]
 
}

model Teacher {
  id    Int     @default(autoincrement()) @id
  name  String?
  phone String  @unique
  password String

  role Role @default(TEACHER)
  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model TestItem {
  id    Int     @default(autoincrement()) @id
  number Int?
  question String? @db.LongText
  answer_A String? @db.LongText
  answer_B String? @db.LongText
  answer_C String? @db.LongText
  answer_D String? @db.LongText
  answer ANSWER?

  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  test  Test?    @relation(fields: [test_id], references: [id])
  test_id  Int?
 
}

model Test {
  id    Int     @default(autoincrement()) @id
  name  String?
  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  section    Section?    @relation(fields: [section_id], references: [id])
  section_id  Int?  @unique
  
  test_items TestItem[]
  results Result[]
}

model SpecialTest {
  id                Int                @id @default(autoincrement())
  name              String
  description       String?
  subject_id        Int
  activation_start  DateTime?
  activation_end    DateTime?
  time_per_question Int?
  total_time        Int?
  force_next_question Boolean?       @default(false)
  question_count    Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  questions         SpecialTestQuestion[]
  specialTestGroups SpecialTestGroup[]
  specialTestBooks  SpecialTestBook[]
  specialTestSections SpecialTestSection[]
  results           Result[]
}

model SpecialTestQuestion {
  id          Int      @id @default(autoincrement())
  number      Int
  question    String   @db.LongText
  answer_A    String   @db.LongText
  answer_B    String   @db.LongText
  answer_C    String?  @db.LongText
  answer_D    String?  @db.LongText
  answer      String   @db.LongText
  specialTest SpecialTest @relation(fields: [specialTestId], references: [id], onDelete: Cascade)
  specialTestId Int
}

model SpecialTestGroup {
  id           Int      @id @default(autoincrement())
  specialTest  SpecialTest @relation(fields: [specialTestId], references: [id])
  specialTestId Int
  group        Group @relation(fields: [groupId], references: [id])
  groupId      Int

  @@unique([specialTestId, groupId])
}

model SpecialTestSection {
  id           Int      @id @default(autoincrement())
  specialTest  SpecialTest @relation(fields: [specialTestId], references: [id])
  specialTestId Int
  section      Section @relation(fields: [sectionId], references: [id])
  sectionId    Int

  @@unique([specialTestId, sectionId])
}

model SpecialTestBook {
  id           Int      @id @default(autoincrement())
  specialTest  SpecialTest @relation(fields: [specialTestId], references: [id])
  specialTestId Int
  book         Book @relation(fields: [bookId], references: [id])
  bookId       Int

  @@unique([specialTestId, bookId])
}