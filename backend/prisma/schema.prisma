model Book {
  id        Int         @id @default(autoincrement())
  name      String?
  image     String?
  createdt  DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  subject    Subject?    @relation(fields: [subject_id], references: [id])
  subject_id Int?

  sections   Section[]
  specialTestBooks SpecialTestBook[]

  fullBlock  Boolean     @default(false)
  stepBlock  Boolean     @default(true)
  passingPercentage Int  @default(60)
  // bookGroups BookGroup[] // <-- use this instead of direct groups
}

model Group {
  id         Int         @id @default(autoincrement())
  name       String?
  students   Student[]

  hasTime Boolean?     @default(false)
  timeMinutes Int? @default(0)
  fullTime   Int? @default(0)
  forceNextQuestion Boolean? @default(false)


  createdt   DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  specialTestGroups SpecialTestGroup[]
  // bookGroups BookGroup[] // <-- use this instead of direct books
}

